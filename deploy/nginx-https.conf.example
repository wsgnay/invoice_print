server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name pdf.wsgnay.cn;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name pdf.wsgnay.cn;

    ssl_certificate /etc/letsencrypt/live/pdf.wsgnay.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pdf.wsgnay.cn/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 160m;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    location / {
        auth_basic "Paperdesk";
        auth_basic_user_file /etc/nginx/.paperdesk.htpasswd;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://127.0.0.1:8000;
    }
}
