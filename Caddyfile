{
    email {$ACME_EMAIL}
}

{$DOMAIN} {
    encode zstd gzip

    request_body {
        max_size 160MB
    }

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    reverse_proxy app:8000
}
